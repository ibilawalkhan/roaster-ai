# Rosterly environment variables.
# Copy to `.env.local` (git-ignored) and fill in real values per environment.
# NEVER commit real keys. Use the Supabase STAGING project for development —
# never develop against the customer's live/production data (REQUIREMENTS.md §9).

# --- Supabase (client-safe) ---
# From Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# --- Supabase (server-only, NEVER exposed to the browser) ---
# Bypasses RLS. Only used in Edge Functions / seed scripts / trusted server code.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Sentry (wired from first deploy — REQUIREMENTS.md §9) ---
NEXT_PUBLIC_SENTRY_DSN=""

# --- Twilio (SMS notifications — used only inside the notify() Edge Function) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""


NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon key>"
SUPABASE_SERVICE_ROLE_KEY="<service_role key>"

# --- Scheduler service (M5 auto-scheduler — Python/OR-Tools, POST /solve) ---
# Base URL only; the client appends "/solve". Leave blank to run without the
# solver: rosters still seed and can be built manually (M5 §10 degradation).
NEXT_PUBLIC_SOLVER_URL=""
