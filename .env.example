# Rosterly environment variables.
# Copy to `.env.local` (git-ignored) and fill in real values per environment.
# NEVER commit real keys. Use the Supabase STAGING project for development —
# never develop against the customer's live/production data (REQUIREMENTS.md §9).

# --- Supabase (client-safe) ---
# From Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# --- Supabase (server-only, NEVER exposed to the browser) ---
# Bypasses RLS entirely. Only for Edge Functions / seed scripts / trusted server
# code. It must NEVER be named with a NEXT_PUBLIC_ prefix: that prefix is
# Next.js's instruction to inline the value into the browser bundle, which would
# hand every visitor the ability to read and write every tenant's data.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Sentry (error monitoring — REQUIREMENTS.md §9, never cut) ---
# Leave the DSN blank to disable monitoring entirely: the SDK becomes a no-op,
# which is the correct behaviour for local development and CI.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""

# Build-time only, for uploading source maps so production stack traces name
# real files and lines. Optional — without them the build simply skips upload.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Scheduler service (M5 auto-scheduler — Python/OR-Tools, POST /solve) ---
# Base URL only; the client appends "/solve". Leave blank to run without the
# solver: rosters still seed and can be built manually (M5 §10 degradation).
NEXT_PUBLIC_SOLVER_URL=""

# --- Twilio (SMS notifications — used only by the notify-worker Edge Function) ---
# These live in Supabase's function secrets, NOT in the app's environment.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
